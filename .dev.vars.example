# Biến môi trường dùng cho `wrangler dev` (Lưu dưới tên .dev.vars)
ENVIRONMENT=development
NEXT_PUBLIC_SITE_URL=http://localhost:8787
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://iam.hnamhocit.workers.dev

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

VNTEZ_JWT_SECRET=your_jwt_secret_signing_key_here
# VNTEZ_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# VNTEZ_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
